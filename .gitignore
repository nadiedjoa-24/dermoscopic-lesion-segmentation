.DS_Store
Thumbs.db

# Local-only exports of the executed notebook (kept out of the repo for size).
# HTML:  python -m nbconvert --to html --embed-images --output-dir docs \n#            --output notebook_export notebooks/01_method_comparison.ipynb
# PDF:   same with --to pdf (needs pandoc and a LaTeX install)
docs/notebook_export.pdf
docs/notebook_export.html

# LaTeX build artefacts for docs/research_paper.pdf. The source, the table
# generator and the generated tables are tracked, so the PDF can be rebuilt
# straight from the repo:
#   python docs/make_results_table.py
#   cd docs && pdflatex research_paper.tex
docs/*.aux
docs/*.log
docs/*.out

# Benchmark artefacts regenerated by scripts/run_benchmark.py
output_srm/
